# Copy to .env and fill in. Never commit .env.

# Discord bot token (bot must be in your server with read/send/manage-webhooks/manage-threads).
DISCORD_BOT_TOKEN=
# Or point at an env file that holds DISCORD_BOT_TOKEN (default: ~/.hermes/.env)
# DVC_ENV_FILE=

# Your server (guild) id and your own Discord user id (used for the webhook name and avatar).
DVC_GUILD=
DVC_OWNER=
# Display name of the webhook the app posts through.
DVC_WEBHOOK_NAME=Voice controller

# Tailscale logins allowed to sign in automatically (comma separated). Empty = access code only.
DVC_TAILNET_OWNERS=

# Brain: "hermes" (default: a Hermes profile over its OpenAI-compatible API) or "local"
# (a ChatGPT text model with the same tools, run inside this app).
DVC_BRAIN=hermes
DVC_HERMES_URL=http://127.0.0.1:8642
DVC_PROFILE=discord-voice
# API key for the Hermes API server (the profile's API_SERVER_KEY).
DVC_HERMES_KEY=

# Voice and text models on your ChatGPT sign-in (read from ~/.codex/auth.json).
DVC_VOICE=cove
DVC_TEXT_MODEL=gpt-5.6-terra

# Set to 1 to require a spoken "yes" before every post (default: posts go out at once, "undo" reverses).
DVC_CONFIRM=0

PORT=3077
HOST=127.0.0.1
